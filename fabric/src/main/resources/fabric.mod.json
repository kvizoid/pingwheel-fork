{
	"schemaVersion": 1,
	"id": "pingwheel",
	"version": "${version}",
	"name": "Ping Wheel (Fork)",
	"description": "Mark locations similar to the ping mechanism found in modern co-op multiplayer games. Enhanced fork with Relay, Multi-Ping, Entity HUD & Auto-Updater.",
	"authors": [
		"Luken",
		"kvz"
	],
	"contributors": [
		"RXJpaw",
		"drnight"
	],
	"contact": {
		"homepage": "https://github.com/kvizoid/pingwheel-fork",
		"sources": "https://github.com/kvizoid/pingwheel-fork",
		"issues": "https://github.com/kvizoid/pingwheel-fork/issues"
	},
	"license": "MIT",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"nx.pingwheel.fabric.FabricClient"
		],
		"main": [
			"nx.pingwheel.fabric.FabricMain"
		],
		"preLaunch": [
			"nx.pingwheel.fabric.PreLaunchUpdater"
		],
		"modmenu": [
			"nx.pingwheel.fabric.integration.ModMenuIntegration"
		],
		"voicechat": [
			"nx.pingwheel.common.integration.VoiceChatIntegration"
		]
	},
	"mixins": [
		"pingwheel.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"fabric-api": "*",
		"minecraft": "26.3"
	}
}
